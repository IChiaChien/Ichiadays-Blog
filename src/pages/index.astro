---
import { Container, FeatureCard, BlogPostsList } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import HomeHeroSection from '../components/sections/heros/HomeHeroSection.astro';
import { parse } from 'date-fns'; // use date to order

// 1. Get the latest 3 posts
const posts = await Astro.glob('./*.mdx').then(posts =>
	posts
		.map(({ frontmatter, url }) => ({
			title: frontmatter.title,
			description: frontmatter.description,
			publishDate: parse(frontmatter.publishDate, 'MMMM d, yyyy', new Date()),
			featuredImage: frontmatter.featuredImage,
			href: url,
		}))
		.sort((a, b) => b.publishDate - a.publishDate) // 按日期降序
		.slice(0, 4) // 只取前 4 篇
);

const seo = {
	title: '一珈寫日子| 日本生活探險, 生活實驗室',
	description: '分享日本留學、東京工作、工程師生活的點點滴滴',
};
---

<Layout {seo}>
	<!-- Part 1: Hero Section -->
	<HomeHeroSection />

	<Container>
        <!-- Part 2: Category -->
		<section class="feature-card__section">
			<h1>文章分類</h1>
			<div class="feature-card__grid">
                <!-- Category 1 -->
				<FeatureCard 
                    href="/category/life-in-japan" 
                    title="🌸 日本探險家" 
                    imgSrc="/assets/images/home/categories/jp_explorer"
                >
                </FeatureCard>
                
                <!-- Category 2 -->
				<FeatureCard 
                    href="/category/life-lab" 
                    title="🥯 生活實驗室" 
                    imgSrc="/assets/images/home/categories/life_lab"
                >
                </FeatureCard>

                <!-- Add more categories here -->
			</div>
		</section>
	</Container>

    <!-- Part3：Recently P -->
	<Container>
		<section class="blog-posts-list__section">
			<h1>最新文章</h1>
			<BlogPostsList posts={posts} />
            
            <div class="view-all-btn">
                <a href="/blog" class="btn">查看所有文章 &rarr;</a>
            </div>
		</section>
	</Container>
</Layout>

<style>
	.feature-card__section,
    .blog-posts-list__section {
		margin: var(--section-margin) auto;
	}

	.feature-card__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr); 
		gap: var(--theme-grid-gap);
	}

    /* 查看更多按鈕樣式 */
    .view-all-btn {
        text-align: center;
        margin-top: 2rem;
    }
    .btn {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        background-color: var(--theme-primary);
        color: var(--theme-on-primary);
        border-radius: var(--theme-button-border-radius);
        text-decoration: none;
        font-weight: 600;
        transition: opacity 0.2s;
    }
    .btn:hover {
        opacity: 0.8;
    }

    /* For smartphone */
	@media (max-width: 768px) {
		.feature-card__grid {
			grid-template-columns: 1fr; /* 手機版變一欄 */
		}
	}
</style>