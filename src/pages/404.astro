---
import { Button, Container, TextCardSection } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';

const seo = {
	title: '找不到頁面 | 一珈寫日子',
	description: '你造訪的頁面不存在，請返回首頁繼續閱讀。',
};
---

<Layout {seo}>
	<Container>
		<TextCardSection>
			<h1>找不到頁面</h1>
			<p>你造訪的網址可能已變更，或暫時無法使用。</p>
			<div class="cta-buttons__container">
				<Button href="/">返回首頁</Button>
			</div>
		</TextCardSection>
	</Container>
</Layout>

<style>
	.cta-buttons__container {
		display: flex;
		flex-wrap: wrap;
	}
	.cta-buttons__container :global(a) {
		margin-right: var(--space-4);
		margin-bottom: var(--space-4);
	}
</style>
