---
const { href, unelevated, outlined, customIcon, onPrimary, newTab } =
  Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class={`btn ${unelevated && `btn--unelevated`} ${
    outlined && `btn--outlined`
  } ${onPrimary && `btn--on-primary`}`}
  href={href}
  target={`${newTab ? '_blank': ``}`}
  rel={`${newTab ? 'noopener noreferrer' : ``}`}
>
  <slot />
  {customIcon && <span class="custom-icon__span"><slot name="icon">custom_icon</slot></span>}
</Tag>

<style>
  .btn {
    width: fit-content;
    padding: var(--space-2) var(--space-4);
    margin-bottom: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-accent);
    color: var(--color-on-accent);
    border: 2px solid transparent;
    border-radius: var(--theme-button-border-radius);
    font-weight: 500;
    font-size: var(--font-size-md);
    transition: background-color var(--theme-transition), color var(--theme-transition), border-color var(--theme-transition);
  }
  .btn:hover {
    background-color: var(--color-accent-hover);
  }
  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .btn--unelevated {
    background-color: transparent;
    color: var(--color-text);
    border-color: transparent;
  }
  .btn--unelevated:hover {
    background-color: transparent;
    color: var(--color-accent);
  }
  .btn--outlined {
    color: var(--color-accent);
    background-color: transparent;
    border-color: var(--color-accent);
  }
  .btn--outlined:hover {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }
  .custom-icon__span {
    margin-left: var(--space-1);
    display: flex;
    align-items: center;
  }

  .custom-icon__span :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  a.btn {
    text-decoration: none;
  }
  button.btn {
    cursor: pointer;
  }
</style>
