---
const {href, imgSrc, title} = Astro.props;
---

<style>
  .feature-card__card {
    background-color: var(--color-surface);
    color: var(--color-text);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    transition: box-shadow var(--theme-transition), transform var(--theme-transition);
  }
  .feature-card__card:hover,
  .feature-card__card:focus-within {
    box-shadow: 0 0.75rem 1.5rem rgba(94, 69, 54, 0.1);
    transform: translateY(-2px);
  }
  .feature-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .featured-card__content {
    padding: var(--space-4) var(--space-4) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .featured-card__content picture {
    width: 100%;
  }
  .feature-card__card .feature-card__img {
    margin: 0 auto;
    width: min(100%, 24rem);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    transition: transform var(--theme-transition);
  }
  .feature-card__card:hover .feature-card__img {
    transform: scale(1.01);
  }
  .feature-card__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-4);
  }
</style>


<div class="feature-card__card">
  <a class="feature-card__link" href={href}>
    <div class="featured-card__content">
      <h3 class="feature-card__title">{title}</h3>
      <picture>
        <source srcset={`${imgSrc}.webp`} type="image/webp" >
        <img class="feature-card__img" src={`${imgSrc}.png`} alt={title} loading="lazy" width="780" height="585" decoding="async" >
      </picture>
    </div>
  </a>
</div>
